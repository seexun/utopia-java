<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  账户域 SQL（源 utopia-store/src/accounts.rs）。P1 任务 7 身份主档切 sys_user（V0101 桥接列）：
  注册/登录/改密/改显示名四条（insertUser/selectUserByEmail/updateUserDisplayName/
  updateUserPassword）随 auth 域舍弃删除；组织/工作区建行的注册编排语句（selectOrgId/
  insertOrg/insertWorkspace/insertMembership/selectEarliestWorkspace/insertGeneralKb/
  insertGeneralKbMember）的编排者 AccountsService 同删，一并退役——建库路径改走
  WorkspaceKbWriteService（WorkspaceMapper）。存活语句仅一条：MCP PAT 认证的
  selectUserById（utopia_uuid → sys_user 行，UserRow 旧列形状经别名折回，业务代码零改动）。
  列映射口径：email→user_name、display_name→nick_name、deactivated_at IS NULL→
  del_flag='0' AND status='0'、is_admin→user_id=1 或授超级管理员角色（sys_role.role_id=1）。
-->
<mapper namespace="tech.seexun.jknow.store.mapper.AccountsMapper">

  <!-- UserRow 列名契约保持（业务代码零改动）：sys_user 列经别名折回旧形状。
       password 由若依持有（业务无登录面）→ 恒 NULL；org 取部署唯一组织（单租户）。 -->
  <resultMap id="userRow" type="tech.seexun.jknow.store.entity.UserRow">
    <constructor>
      <idArg column="id" javaType="java.util.UUID"/>
      <arg column="org_id" javaType="java.util.UUID"/>
      <arg column="email" javaType="java.lang.String"/>
      <arg column="password_hash" javaType="java.lang.String"/>
      <arg column="display_name" javaType="java.lang.String"/>
      <arg column="is_admin" javaType="_boolean"/>
      <arg column="created_at" javaType="java.time.OffsetDateTime"/>
      <arg column="deactivated_at" javaType="java.time.OffsetDateTime"/>
    </constructor>
  </resultMap>

  <!-- accounts.rs:234-241（find_user_by_id：PAT 会话校验走它，停用立即生效）——
       身份主档切 sys_user（P1 任务 7）：按 utopia_uuid 查，谓词 del_flag='0'（未删）
       AND status='0'（未停用）＝旧 deactivated_at IS NULL 的两道门。 -->
  <select id="selectUserById" resultMap="userRow">
    SELECT su.utopia_uuid AS id,
           (SELECT o.id FROM organizations o ORDER BY o.created_at LIMIT 1) AS org_id,
           su.user_name AS email,
           NULL::text AS password_hash,
           su.nick_name AS display_name,
           (su.user_id = 1 OR EXISTS (SELECT 1 FROM sys_user_role ur
                WHERE ur.user_id = su.user_id AND ur.role_id = 1)) AS is_admin,
           su.create_time AT TIME ZONE 'UTC' AS created_at,
           NULL::timestamptz AS deactivated_at
      FROM sys_user su
     WHERE su.utopia_uuid = #{id} AND su.del_flag = '0' AND su.status = '0'
  </select>
</mapper>
